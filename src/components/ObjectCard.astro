---
import { Image } from 'astro:assets';
import type { PublicObject } from '../lib/content';
import { itemPath, statusLabel } from '../lib/content';
import { sitePath } from '../lib/urls';

interface Props { object: PublicObject; index?: number; headingLevel?: 2 | 3; }
const { object, index = 0, headingLevel = 3 } = Astro.props;
const { data } = object;
---
<article class="object-card">
  <a class="object-image-link" href={sitePath(itemPath(object.id))} aria-label={`View ${data.title}`}>
    <Image src={data.images[0].src} alt={data.images[0].alt} loading={index < 2 ? 'eager' : 'lazy'} class="object-image" />
  </a>
  <div class="object-meta"><span>{data.category}</span><span>{data.year}</span></div>
  {headingLevel === 2
    ? <h2><a href={sitePath(itemPath(object.id))}>{data.title}</a></h2>
    : <h3><a href={sitePath(itemPath(object.id))}>{data.title}</a></h3>}
  <p class="object-summary">{data.summary}</p>
  <p class="object-status">{statusLabel(data.status)}</p>
</article>
