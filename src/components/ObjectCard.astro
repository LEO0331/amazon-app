---
import { Image } from 'astro:assets';
import type { PublicObject } from '../lib/content';
import { itemPath, statusLabel } from '../lib/content';
import { localePath, localizedObject, ui, type Locale } from '../i18n';

interface Props { object: PublicObject; headingLevel?: 2 | 3; locale?: Locale; }
const { object, headingLevel = 3, locale = 'en' } = Astro.props;
const { data } = object;
const view = localizedObject(object, locale);
const href = localePath(locale, itemPath(object.id));
---
<article class="object-card">
  <a class="object-image-link" href={href} aria-label={`${ui[locale].item.view} ${view.title}`}>
    <Image src={data.images[0].src} alt={view.imageAlts[0]} loading="lazy" class="object-image" />
  </a>
  <div class="object-meta"><span>{view.category}</span><span>{data.year}</span></div>
  {headingLevel === 2
    ? <h2><a href={href}>{view.title}</a></h2>
    : <h3><a href={href}>{view.title}</a></h3>}
  <p class="object-summary">{view.summary}</p>
  <p class="object-status">{data.type === 'memory' ? ui[locale].item.memory : locale === 'en' ? statusLabel(data.status) : ui.zh.status[data.status]}</p>
</article>
