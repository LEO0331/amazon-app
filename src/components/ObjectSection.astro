---
import ObjectCard from './ObjectCard.astro';
import type { PublicObject } from '../lib/content';
import { localePath, type Locale } from '../i18n';
interface Props { eyebrow: string; title: string; description: string; objects: PublicObject[]; link: string; linkLabel: string; locale?: Locale; }
const { eyebrow, title, description, objects, link, linkLabel, locale = 'en' } = Astro.props;
---
<section class="section wrap">
  <div class="section-header">
    <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p class="section-intro">{description}</p></div>
    <a class="text-link" href={localePath(locale, link)}>{linkLabel}<span aria-hidden="true"> ↗</span></a>
  </div>
  <div class="object-grid">{objects.map((object) => <ObjectCard object={object} locale={locale} />)}</div>
</section>
