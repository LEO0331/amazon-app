---
import ObjectCard from './ObjectCard.astro';
import type { PublicObject } from '../lib/content';
import { sitePath } from '../lib/urls';
interface Props { eyebrow: string; title: string; description: string; objects: PublicObject[]; link: string; linkLabel: string; }
const { eyebrow, title, description, objects, link, linkLabel } = Astro.props;
---
<section class="section wrap">
  <div class="section-header">
    <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p class="section-intro">{description}</p></div>
    <a class="text-link" href={sitePath(link)}>{linkLabel}<span aria-hidden="true"> ↗</span></a>
  </div>
  <div class="object-grid">{objects.map((object, index) => <ObjectCard object={object} index={index} />)}</div>
</section>
