---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = ui[locale].about;
---
<BaseLayout title={t.title} description={t.description} locale={locale}>
  <header class="page-heading wrap"><p class="eyebrow">{t.eyebrow}</p><h1>{t.heading}</h1><p class="page-intro">{t.intro}</p></header>
  <section class="about-body wrap"><h2>{t.section}</h2><div class="about-copy"><p>{t.paragraph1}</p><p>{t.paragraph2}</p><p class="about-small">{t.paragraph3}</p></div></section>
</BaseLayout>
