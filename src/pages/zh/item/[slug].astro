---
import ItemRecord from '../../../components/ItemRecord.astro';
import { getPublicObjects, type PublicObject } from '../../../lib/content';

export async function getStaticPaths() {
  const objects = await getPublicObjects();
  return objects.map((object) => ({
    params: { slug: object.id.replace(/\.md$/, '') },
    props: {
      object,
      related: objects.filter((candidate) => candidate.id !== object.id && candidate.data.type === object.data.type).slice(0, 4),
    },
  }));
}

interface Props { object: PublicObject; related: PublicObject[]; }
const { object, related } = Astro.props;
---
<ItemRecord object={object} related={related} locale="zh" />
