---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ObjectSection from '../components/ObjectSection.astro';
import { getPublicObjects, newestFirst } from '../lib/content';
import { localePath, localizedObject, ui, type Locale } from '../i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = ui[locale].home;
const objects = newestFirst(await getPublicObjects());
const made = objects.filter((object) => object.data.type === 'made');
const collected = objects.filter((object) => object.data.type === 'collected');
---
<BaseLayout title={locale === 'zh' ? '家庭藏櫃' : 'Family Cabinet'} description={t.description} locale={locale}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">Family<br /><em>Cabinet</em></h1>
      <p class="hero-subtitle">{t.subtitle1}<br />{t.subtitle2}</p>
      <p class="hero-description">{t.intro}</p>
      <a class="button-link" href={localePath(locale, 'archive/')}>{t.explore} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-visual" aria-label={t.visualLabel}>
      {made[0] && <Image src={made[0].data.images[0].src} alt={localizedObject(made[0], locale).imageAlts[0]} loading="eager" />}
      {collected[0] && <Image src={collected[0].data.images[0].src} alt={localizedObject(collected[0], locale).imageAlts[0]} loading="eager" />}
      <span class="hero-caption">{t.visualCaption}</span>
    </div>
  </section>
  <ObjectSection eyebrow={t.madeEyebrow} title={t.madeTitle} description={t.madeDescription} objects={made.slice(0, 4)} link="made/" linkLabel={t.madeLink} locale={locale} />
  <ObjectSection eyebrow={t.collectedEyebrow} title={t.collectedTitle} description={t.collectedDescription} objects={collected.slice(0, 4)} link="collected/" linkLabel={t.collectedLink} locale={locale} />
  <section class="philosophy"><div class="philosophy-inner wrap"><p class="eyebrow">{t.philosophyEyebrow}</p><div><blockquote>{t.philosophyQuote}</blockquote><p>{t.philosophyNote}</p></div></div></section>
  <ObjectSection eyebrow={t.recentEyebrow} title={t.recentTitle} description={t.recentDescription} objects={objects.slice(0, 4)} link="archive/" linkLabel={t.recentLink} locale={locale} />
</BaseLayout>
